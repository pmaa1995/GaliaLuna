{
  "name": "galia-luna",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs",
    "typecheck": "next typegen && tsc --noEmit",
    "studio": "npm --prefix studio run dev",
    "studio:install": "npm --prefix studio ci",
    "studio:build": "npm --prefix studio run build",
    "studio:typecheck": "npm --prefix studio run typecheck",
    "studio:deploy": "npm --prefix studio run deploy",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@clerk/localizations": "3.37.9",
    "@clerk/nextjs": "6.39.7",
    "@opennextjs/cloudflare": "1.20.7",
    "@sanity/client": "7.27.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
